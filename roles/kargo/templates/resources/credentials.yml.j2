apiVersion: v1
kind: Secret
metadata:
  name: "{{ kargo_credential.name }}"
  namespace: "{{ kargo_credential.project | default(kargo_shared_resources_namespace) }}"
  labels:
    kargo.akuity.io/cred-type: "{{ kargo_credential.type }}"
{% for key, value in (kargo_credential.labels | default({})).items() %}
    {{ key }}: {{ value | ansible.builtin.to_json }}
{% endfor %}
type: Opaque
stringData:
  repoURL: {{ kargo_credential.repo_url | ansible.builtin.to_json }}
{% if kargo_credential.repo_url_is_regex | default(false) %}
  repoURLIsRegex: "true"
{% endif %}
{% for key, value in (kargo_credential.parameters | default({})).items() %}
  {{ key }}: {{ value | string | ansible.builtin.to_json }}
{% endfor %}
