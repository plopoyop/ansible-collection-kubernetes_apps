apiVersion: kargo.akuity.io/v1alpha1
kind: ClusterPromotionTask
metadata:
  name: "{{ kargo_cluster_promotion_task.name }}"
{% if kargo_cluster_promotion_task.labels is defined %}
  labels: {{ kargo_cluster_promotion_task.labels | ansible.builtin.to_json }}
{% endif %}
{% if kargo_cluster_promotion_task.annotations is defined %}
  annotations: {{ kargo_cluster_promotion_task.annotations | ansible.builtin.to_json }}
{% endif %}
spec:
{% if kargo_cluster_promotion_task.vars is defined %}
  vars: {{ kargo_cluster_promotion_task.vars | ansible.builtin.to_json }}
{% endif %}
  steps: {{ kargo_cluster_promotion_task.steps | ansible.builtin.to_json }}
