apiVersion: "v1"
kind: "Secret"
metadata:
  name: {{ external_secrets_secret.name | ansible.builtin.to_json }}
  namespace: {{ (external_secrets_secret.namespace | default(external_secrets_namespace)) | ansible.builtin.to_json }}
{% if external_secrets_secret.labels | default({}, true) %}
  labels:
{% for key, value in external_secrets_secret.labels.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_secret.annotations | default({}, true) %}
  annotations:
{% for key, value in external_secrets_secret.annotations.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_secret.type is defined %}
type: {{ external_secrets_secret.type | ansible.builtin.to_json }}
{% endif %}
{% if external_secrets_secret.data | default({}, true) or external_secrets_secret.stringData | default({}, true) %}
data:
{% for key, value in (external_secrets_secret.data | default({}, true)).items() if key not in (external_secrets_secret.stringData | default({}, true)) %}
  {{ key | ansible.builtin.to_json }}: {{ (value if value is string else value | ansible.builtin.to_json) | ansible.builtin.to_json }}
{% endfor %}
{% for key, value in (external_secrets_secret.stringData | default({}, true)).items() %}
  {{ key | ansible.builtin.to_json }}: {{ (value if value is string else value | ansible.builtin.to_json) | ansible.builtin.b64encode | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
