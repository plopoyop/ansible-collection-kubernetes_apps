apiVersion: "generators.external-secrets.io/v1alpha1"
kind: "ClusterGenerator"
metadata:
  name: "{{ external_secrets_cluster_generator.name }}"
{% if external_secrets_cluster_generator.labels | default({}, true) %}
  labels:
{% for key, value in external_secrets_cluster_generator.labels.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_cluster_generator.annotations | default({}, true) %}
  annotations:
{% for key, value in external_secrets_cluster_generator.annotations.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
spec:
{{ (external_secrets_cluster_generator.spec | default({}, true)) | ansible.builtin.to_nice_yaml | indent(width=2, first=true) }}
