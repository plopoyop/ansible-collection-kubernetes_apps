apiVersion: "external-secrets.io/v1"
kind: "SecretStore"
metadata:
  name: "{{ external_secrets_secret_store.name }}"
  namespace: "{{ external_secrets_secret_store.namespace | default(external_secrets_namespace) }}"
{% if external_secrets_secret_store.labels | default({}, true) %}
  labels:
{% for key, value in external_secrets_secret_store.labels.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_secret_store.annotations | default({}, true) %}
  annotations:
{% for key, value in external_secrets_secret_store.annotations.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
spec:
{{ (external_secrets_secret_store.spec | default({}, true)) | ansible.builtin.to_nice_yaml | indent(width=2, first=true) }}
