apiVersion: "external-secrets.io/v1"
kind: "ClusterExternalSecret"
metadata:
  name: "{{ external_secrets_cluster_external_secret.name }}"
{% if external_secrets_cluster_external_secret.labels | default({}, true) %}
  labels:
{% for key, value in external_secrets_cluster_external_secret.labels.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_cluster_external_secret.annotations | default({}, true) %}
  annotations:
{% for key, value in external_secrets_cluster_external_secret.annotations.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
spec:
{{ (external_secrets_cluster_external_secret.spec | default({}, true)) | ansible.builtin.to_nice_yaml | indent(width=2, first=true) }}
