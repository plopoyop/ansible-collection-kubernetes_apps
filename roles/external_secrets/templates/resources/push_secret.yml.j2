apiVersion: "external-secrets.io/v1alpha1"
kind: "PushSecret"
metadata:
  name: "{{ external_secrets_push_secret.name }}"
  namespace: "{{ external_secrets_push_secret.namespace | default(external_secrets_namespace) }}"
{% if external_secrets_push_secret.labels | default({}, true) %}
  labels:
{% for key, value in external_secrets_push_secret.labels.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
{% if external_secrets_push_secret.annotations | default({}, true) %}
  annotations:
{% for key, value in external_secrets_push_secret.annotations.items() %}
    {{ key | ansible.builtin.to_json }}: {{ (value if value is string else ('' if value is none else value | ansible.builtin.to_json)) | ansible.builtin.to_json }}
{% endfor %}
{% endif %}
spec:
{{ (external_secrets_push_secret.spec | default({}, true)) | ansible.builtin.to_nice_yaml | indent(width=2, first=true) }}
